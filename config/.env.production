## Environment ##
NODE_ENV=production

## Database (required) ##
# Everything in this file is a FALLBACK template. The real values must be
# set as environment variables on your host (Render: your service ->
# Environment) — values set there override this file. Never commit real
# secrets here.
MONGO_URI=your_production_mongo_uri

## Auth (required) ##
JWT_SECRET=your_production_jwt_secret
JWT_EXPIRES_IN=7d


## Server ##
PORT=8081
HOST=localhost


## Setup jet-logger ##
# CONSOLE so logs show up in the hosting platform's log stream.
JET_LOGGER_MODE=CONSOLE
JET_LOGGER_FILEPATH=jet-logger.log
JET_LOGGER_TIMESTAMP=TRUE
JET_LOGGER_FORMAT=LINE

## Payments (Flutterwave) ##
FLUTTERWAVE_PUBLIC_KEY=your_flutterwave_public_key
FLUTTERWAVE_SECRET_KEY=your_flutterwave_secret_key
FLUTTERWAVE_REDIRECT_URL=https://yourfrontend.com/payment-success
FLW_WEBHOOK_SECRET=your_flutterwave_webhook_secret
FLW_BASE_URL=https://api.flutterwave.com/v3

## Uploads (Cloudinary) ##
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Comma-separated list of allowed frontend origins.
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
